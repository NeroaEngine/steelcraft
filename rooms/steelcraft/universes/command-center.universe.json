    { "id": "projects", "label": "Projects", "route": "/command-center/projects", "card_group": "projects" },
    { "id": "accounting", "label": "Accounting", "route": "/command-center/accounting", "card_group": "accounting" },
    { "id": "erection", "label": "Erection", "route": "/command-center/erection", "card_group": "erection" },
    { "id": "billing", "label": "Billing", "route": "/command-center/billing", "card_group": "billing" },
    { "id": "documents", "label": "Documents", "route": "/command-center/documents", "card_group": "documents" },
    { "id": "profile", "label": "Profile", "route": "/command-center/profile", "card_group": "profile" }
